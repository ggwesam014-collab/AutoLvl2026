-- 2. تحديد البحر واللفل
-- =================================================================
local function GetCurrentSea()
    local placeId = game.PlaceId
    if placeId == 2753915549 then return "FirstSea"
    elseif placeId == 4442272183 then return "SecondSea"
    elseif placeId == 7449423635 then return "ThirdSea"
    else return "SecondSea" end
end

local function GetMyQuestData()
    local sea = GetCurrentSea()
    local level = 1
    pcall(function() level = LocalPlayer.Data.Level.Value end)
    for _, quest in pairs(QuestsData[sea]) do
        if level >= quest.MinLevel and level <= quest.MaxLevel then return quest end
    end
    return QuestsData[sea][#QuestsData[sea]]
end

-- =================================================================
-- 3. نظام التوين المستقر (TweenService - Speed 220)
-- =================================================================
local currentTween = nil

local function SafeTween(targetCFrame)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    
    -- إذا كان قريب جداً يتنقل فوراً
    if distance < 10 then
        hrp.CFrame = targetCFrame
        return
    end

    local speed = 200 -- سرعة آمنة تمنع الـ Anti-Cheat من إرجاعك
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)

    -- إلغاء التصادم والجاذبية
    local bv = hrp:FindFirstChild("RedzVelocity") or Instance.new("BodyVelocity")
    bv.Name = "RedzVelocity"
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Parent = hrp

    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
 
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
end

-- =================================================================
-- 4. البحث عن الوحش في الـ Workspace
-- =================================================================
local function GetTargetEnemy(enemyName)
    if workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
            if enemy.Name == enemyName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                if enemy:FindFirstChild("HumanoidRootPart") then
                    return enemy
                end
            end
        end
    end
    return nil
end

local function FastAttack()
    pcall(function()
        local weapon = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if weapon then
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack"):FireServer(0)
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit"):FireServer(weapon)
        end
    end)
end

-- =================================================================
-- 5. الحلقة الرئيسية
-- =================================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local questData = GetMyQuestData()
            if questData then
                local myGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
                local hasQuest = myGui and myGui:FindFirstChild("Quest") and myGui.Quest.Visible

                if not hasQuest then
                    -- الذهاب لأخذ المهمة
                    local npcPos = questData.FallbackNPC
                    if workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(questData.NPCName) then
                        npcPos = workspace.NPCs[questData.NPCName].HumanoidRootPart.CFrame
                    end
                    
                    SafeTween(npcPos * CFrame.new(0, 2, 3))
                    if (LocalPlayer.Character.HumanoidRootPart.Position - npcPos.Position).Magnitude < 10 then
                        CommF:InvokeServer("StartQuest", questData.QuestName, 1)
                    end
                else
                    -- الذهاب لقتل الوحش
                    local enemy = GetTargetEnemy(questData.EnemyName)
                    if enemy then
                        local enemyPos = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0)
                        SafeTween(enemyPos)
                        
                        -- الضرب إذا وصل فوق الوحش
                        if (LocalPlayer.Character.HumanoidRootPart.Position - enemyPos.Position).Magnitude < 15 then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = enemyPos
                            FastAttack()
                        end
                    else
                        -- إذا لم ترسبن الوحوش ينتظر في المكان
                        SafeTween(questData.FallbackNPC * CFrame.new(0, 30, 0))
                    end
                end
            end
        end
    end
end)

