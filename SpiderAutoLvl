local function GetCurrentSea()
    local placeId = game.PlaceId
    if placeId == 2753915549 then return "FirstSea"
    elseif placeId == 4442272183 then return "SecondSea"
    elseif placeId == 7449423635 then return "ThirdSea"
    else return "SecondSea" end
end

local function GetMyQuestData()
    local sea = GetCurrentSea()
    local level = 1
    pcall(function() level = LocalPlayer.Data.Level.Value end)
    for _, quest in pairs(QuestsData[sea]) do
        if level >= quest.MinLevel and level <= quest.MaxLevel then return quest end
    end
    return QuestsData[sea][#QuestsData[sea]]
end

-- =================================================================
-- 2. المحرك المطور لمنع الـ Rubberband (Anti-Rubberband Engine)
-- =================================================================
local function ResetVelocity(char)
    if not char then return end
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("BasePart") then
            v.Velocity = Vector3.new(0, 0, 0)
            v.RotVelocity = Vector3.new(0, 0, 0)
        end
    end
end

local function SmoothBypassBlink(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local dist = (hrp.Position - targetCFrame.Position).Magnitude

    -- تعطيل التصادم
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    if dist <= 12 then
        hrp.CFrame = targetCFrame
        ResetVelocity(char)
        return
    end

    -- تقسيم المسافة إلى أجزاء صغيرة جداً (Steps) مع مراعاة سرعة السيرفر الآمنة
    local stepSize = 18 -- حجم القفزة الواحدة
    local currentPos = hrp.Position
    local targetPos = targetCFrame.Position
    local direction = (targetPos - currentPos).Unit
    local steps = math.floor(dist / stepSize)

    for i = 1, steps do
        if not _G.AutoFarm or not LocalPlayer.Character then break end
        
        currentPos = currentPos + (direction * stepSize)
        hrp.CFrame = CFrame.new(currentPos, targetPos)
        ResetVelocity(char)

        -- تأخير آمن جداً يمنع كشف السيرفر للحركة
        task.wait(0.02)
    end

    if _G.AutoFarm and LocalPlayer.Character then
        hrp.CFrame = targetCFrame
        ResetVelocity(char)
    end
end

