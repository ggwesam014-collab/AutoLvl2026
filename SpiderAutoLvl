-- 3. منطق التلفيل المباشر
-- =================================================================
local lastQuestTime = 0

local function HasQuestActive()
    local myGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
    if myGui and myGui:FindFirstChild("Quest") then
        return myGui.Quest.Visible
    end
    return false
end

local function GetTargetEnemy(enemyName)
    if workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
            if enemy.Name == enemyName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                if enemy:FindFirstChild("HumanoidRootPart") then
                    return enemy
                end
            end
        end
    end
    return nil
end

local function FastAttack()
    pcall(function()
        local weapon = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if weapon then
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack"):FireServer(0)
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit"):FireServer(weapon)
        end
    end)
end

-- =================================================================
-- 4. الحلقة الأساسية
-- =================================================================
task.spawn(function()
    while true do
        task.wait(0.05)
        if _G.AutoFarm then
            local questData = GetMyQuestData()
            if questData then
                local questActive = HasQuestActive()

                if not questActive then
                    -- الذهاب واستلام المهمة
                    local npcPos = questData.FallbackNPC
                    if workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(questData.NPCName) then
                        local npc = workspace.NPCs[questData.NPCName]
                        if npc:FindFirstChild("HumanoidRootPart") then
                            npcPos = npc.HumanoidRootPart.CFrame
                        end
                    end

                    SmoothBypassBlink(npcPos * CFrame.new(0, 2, 3))

                    if (LocalPlayer.Character.HumanoidRootPart.Position - npcPos.Position).Magnitude < 15 then
                        if tick() - lastQuestTime > 1.2 then
                            lastQuestTime = tick()
                            CommF:InvokeServer("StartQuest", questData.QuestName, 1)
                        end
                    end
                else
                    -- الذهاب وقتل الأعداء
                    local enemy = GetTargetEnemy(questData.EnemyName)
                    if enemy then
                        local enemyPos = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0)
                        local dist = (LocalPlayer.Character.HumanoidRootPart.Position - enemyPos.Position).Magnitude

                        if dist > 10 then
                            SmoothBypassBlink(enemyPos)
                        else
                            LocalPlayer.Character.HumanoidRootPart.CFrame = enemyPos
                            ResetVelocity(LocalPlayer.Character)
                            FastAttack()
                        end
                    else
                        -- الانتظار فوق موقع الوحوش عند إعادة الإرسال (Respawn)
                        SmoothBypassBlink(questData.FallbackNPC * CFrame.new(0, 15, 0))
                    end
                end
            end
        end
    end
end)

