-- =================================================================
-- 2. التعرف على البحر والبيانات
-- =================================================================
local function GetCurrentSea()
    local placeId = game.PlaceId
    if placeId == 2753915549 then return "FirstSea"
    elseif placeId == 4442272183 then return "SecondSea"
    elseif placeId == 7449423635 then return "ThirdSea"
    else return "SecondSea" end
end

local function GetMyQuestData()
    local sea = GetCurrentSea()
    local level = 1
    pcall(function()
        level = LocalPlayer.Data.Level.Value
    end)
    
    for _, quest in pairs(QuestsData[sea]) do
        if level >= quest.MinLevel and level <= quest.MaxLevel then
            return quest
        end
    end
    return QuestsData[sea][#QuestsData[sea]]
end

-- =================================================================
-- 3. جلب الـ NPC مع خطة احتياطية للإحداثيات
-- =================================================================
local function GetNPCCFrame(questData)
    if workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(questData.NPCName) then
        local npc = workspace.NPCs[questData.NPCName]
        if npc:FindFirstChild("HumanoidRootPart") then
            return npc.HumanoidRootPart.CFrame
        end
    end
    return questData.FallbackNPC
end

local function GetEnemyModel(enemyName)
    if workspace:FindFirstChild("Enemies") then
        for _, v in pairs(workspace.Enemies:GetChildren()) do
            if v.Name == enemyName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                if v:FindFirstChild("HumanoidRootPart") then
                    return v
                end
            end
        end
    end
    return nil
end

-- =================================================================
-- 4. حركة Redz Smooth Tween (Speed 300)
-- =================================================================
local function RedzTween(targetCFrame)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local speed = 300

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = hrp

    local noclip = RunService.Stepped:Connect(function()
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local travelTime = distance / speed
    local startTime = tick()

    while (tick() - startTime) < travelTime and _G.AutoFarm do
        if not character or not character:FindFirstChild("HumanoidRootPart") then break end
        local alpha = (tick() - startTime) / travelTime
        hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, alpha)
        RunService.Heartbeat:Wait()
    end

    if hrp then hrp.CFrame = targetCFrame end
    bodyVelocity:Destroy()
    noclip:Disconnect()
end

-- =================================================================
-- 5. الضرب السريع Fast Attack
-- =================================================================
local function FastAttack()
    pcall(function()
        local weapon = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if weapon then
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack"):FireServer(0)
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit"):FireServer(weapon)
        end
    end)
end

-- =================================================================
-- 6. الحلقة الأساسية
-- =================================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local questData = GetMyQuestData()
            if questData then
                local myGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
                local hasQuest = myGui and myGui:FindFirstChild("Quest") and myGui.Quest.Visible

                if not hasQuest then
                    -- الانقال للـ NPC أخذ المهمة
                    local npcPos = GetNPCCFrame(questData)
                    if npcPos then
                        RedzTween(npcPos * CFrame.new(0, 2, 3))
                        task.wait(0.3)
                        pcall(function()
                            CommF:InvokeServer("StartQuest", questData.QuestName, 1)
                        end)
                    end
                else
                    -- البحث عن الوحش أو الانتقال لمنطقته الاحتياطية
                    local enemy = GetEnemyModel(questData.EnemyName)
                    if enemy then
                        local targetPos = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 9, 0)
                        if (LocalPlayer.Character.HumanoidRootPart.Position - targetPos.Position).Magnitude > 15 then
                            RedzTween(targetPos)
                        else
                            LocalPlayer.Character.HumanoidRootPart.CFrame = targetPos
                            FastAttack()
                        end
                    else
                        -- إذا لم يتكون الوحش بعد، ينتظر في منطقته
                        RedzTween(questData.FallbackNPC * CFrame.new(0, 20, 20))
                    end
                end
            end
        end
    end
end)

