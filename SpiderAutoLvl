-- معرفة البحر المباشر
local function GetCurrentSea()
    local pId = game.PlaceId
    if pId == 2753915549 then return "FirstSea"
    elseif pId == 4442272183 then return "SecondSea"
    elseif pId == 7449423635 then return "ThirdSea"
    else return "FirstSea" end
end

-- معرفة اللفل
local function GetPlayerLevel()
    local lvl = 1
    pcall(function()
        if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
            lvl = LocalPlayer.Data.Level.Value
        elseif LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Level") then
            local txt = LocalPlayer.PlayerGui.Main.Level.Text
            lvl = tonumber(string.match(txt, "%d+")) or 1
        end
    end)
    return lvl
end

local function GetMyQuestData()
    local sea = GetCurrentSea()
    local level = GetPlayerLevel()
    local questList = AllQuests[sea] or AllQuests["FirstSea"]

    for _, quest in ipairs(questList) do
        if level >= quest.MinLevel and level <= quest.MaxLevel then
            return quest
        end
    end
    return questList[1]
end

-- =================================================================
-- 2. الطيران العالي الآمن (منع السقوط في البحر نهائياً)
-- =================================================================
local function HighFlyTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    
    -- NoClip لمنع الاصطدام
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Velocity = Vector3.new(0, 0, 0)
        end
    end

    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist < 15 then
        hrp.CFrame = targetCFrame
        return
    end

    -- الارتفاع الآمن فوق مستوى البحر بأمان (Y = 250+)
    local safeY = math.max(hrp.Position.Y, targetCFrame.Position.Y)
    if safeY < 200 then safeY = 250 end

    -- مرحلة 1: الصعود للارتفاع الآمن
    if hrp.Position.Y < safeY - 20 then
        hrp.CFrame = CFrame.new(hrp.Position.X, safeY, hrp.Position.Z)
        task.wait(0.05)
    end

    -- مرحلة 2: الحركة الأفوقية المباشرة
    local targetHighPos = Vector3.new(targetCFrame.Position.X, safeY, targetCFrame.Position.Z)
    local step = 25
    local horizDist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetHighPos.X, 0, targetHighPos.Z)).Magnitude
    local steps = math.floor(horizDist / step)
    local dir = (targetHighPos - hrp.Position).Unit

    for i = 1, steps do
        if not _G.AutoFarm or not LocalPlayer.Character then break end
        
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end

        hrp.CFrame = hrp.CFrame + (dir * step)
        hrp.Velocity = Vector3.new(0, 0, 0)
        task.wait(0.01)
    end

    -- مرحلة 3: النزول للهدف
    if _G.AutoFarm and LocalPlayer.Character then
        hrp.CFrame = targetCFrame
        hrp.Velocity = Vector3.new(0, 0, 0)
    end
end

-- =================================================================
-- 3. تجهيز السلاح والضرب
-- =================================================================
local function EquipWeapon()
    pcall(function()
        local backpack = LocalPlayer.Backpack
        local char = LocalPlayer.Character
        if not char then return end

        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.ToolTip == "Melee" or item.ToolTip == "Sword" or item:FindFirstChild("Combat")) then
                char.Humanoid:EquipTool(item)
                break
            end
        end
    end)
end

local function HasQuestActive()
    pcall(function()
        local myGui = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if myGui and myGui:FindFirstChild("Quest") then
            return myGui.Quest.Visible
        end
    end)
    return false
end

local function GetTargetEnemy(enemyName)
    if workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
            if enemy.Name == enemyName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                if enemy:FindFirstChild("HumanoidRootPart") then
                    return enemy
                end
            end
        end
    end
    return nil
end

local function FastAttack()
    pcall(function()
        EquipWeapon()
        local weapon = LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if weapon then
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterAttack"):FireServer(0)
            ReplicatedStorage.Modules.Net:FindFirstChild("RE/RegisterHit"):FireServer(weapon)
        end
    end)
end

-- =================================================================
-- 4. المحرك الرئيسي للثبات والقتال
-- =================================================================
local lastQuestAttempt = 0

task.spawn(function()
    while true do
        task.wait(0.03)
        if _G.AutoFarm then
            pcall(function()
                local questData = GetMyQuestData()
                if questData then
                    local questActive = HasQuestActive()

                    if not questActive then
                        -- الذهاب للـ NPC والأخذ
                        local npcPos = questData.FallbackNPC
                        if workspace:FindFirstChild("NPCs") and workspace.NPCs:FindFirstChild(questData.NPCName) then
                            local npc = workspace.NPCs[questData.NPCName]
                            if npc:FindFirstChild("HumanoidRootPart") then
                                npcPos = npc.HumanoidRootPart.CFrame
                            end
                        end

                        HighFlyTo(npcPos * CFrame.new(0, 1, 2))

                        local dist = (LocalPlayer.Character.HumanoidRootPart.Position - npcPos.Position).Magnitude
                        if dist < 15 then
                            if tick() - lastQuestAttempt > 0.8 then
                                lastQuestAttempt = tick()
                                CommF:InvokeServer("StartQuest", questData.QuestName, questData.LevelReq or 1)
                            end
                        end
                    else
                        -- قتال الوحش
                        local enemy = GetTargetEnemy(questData.EnemyName)
                        if enemy then
                            local enemyPos = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 6, 0)
                            local dist = (LocalPlayer.Character.HumanoidRootPart.Position - enemyPos.Position).Magnitude

                            if dist > 15 then
                                HighFlyTo(enemyPos)
                            else
                                LocalPlayer.Character.HumanoidRootPart.CFrame = enemyPos
                                LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                                FastAttack()
                            end
                        else
                            -- في حال عدم رسبنة الوحش، الذهاب لمكان الرسبنة المضمون
                            HighFlyTo(questData.FallbackNPC * CFrame.new(0, 15, 0))
                        end
                    end
                end
            end)
        end
    end
end)

