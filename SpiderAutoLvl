-- =================================================================
-- 2. Custom Tween System (نظام التنقل السلس والحماية)
-- =================================================================
local function CustomTween(targetCFrame, speed)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    speed = speed or 300

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = hrp

    local noclipConnection = RunService.Stepped:Connect(function()
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local travelTime = distance / speed
    local startTime = tick()

    while (tick() - startTime) < travelTime and _G.AutoFarm do
        if not character or not character:FindFirstChild("HumanoidRootPart") then break end
        local alpha = (tick() - startTime) / travelTime
        hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, alpha)
        RunService.Heartbeat:Wait()
    end

    if hrp then hrp.CFrame = targetCFrame end
    bodyVelocity:Destroy()
    noclipConnection:Disconnect()
end

-- =================================================================
-- 3. الدوال التابعة لـ Auto Farm
-- =================================================================
local function GetCurrentWorld()
    local placeId = game.PlaceId
    if placeId == 2753915549 then return "FirstSea"
    elseif placeId == 4442272183 then return "SecondSea"
    elseif placeId == 7449423635 then return "ThirdSea"
    else return "FirstSea" end
end

local function GetMyQuestData()
    local level = 1
    if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
        level = LocalPlayer.Data.Level.Value
    end
    
    local world = GetCurrentWorld()
    for _, quest in pairs(QuestsData[world]) do
        if level >= quest.MinLevel and level <= quest.MaxLevel then
            return quest
        end
    end
    return nil
end

-- =================================================================
-- 4. الحلقة الرئيسية لـ Auto Farm
-- =================================================================
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local questData = GetMyQuestData()
            if questData then
                -- 1. التأكد من أخذ المهمة
                local hasQuest = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest") and LocalPlayer.PlayerGui.Main.Quest.Visible
                
                if not hasQuest then
                    CustomTween(questData.QuestNPC * CFrame.new(0, 0, 3), 300)
                    task.wait(0.5)
                    pcall(function()
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questData.QuestName, 1)
                    end)
                else
                    -- 2. الانتقال إلى مكان الوحوش والهجوم
                    CustomTween(questData.EnemyCFrame * CFrame.new(0, 10, 0), 300)
                    
                    -- محاكاة الضرب والتجميع (مثال تجريبي)
                    pcall(function()
                        game:GetService("VirtualUser"):CaptureController()
                        game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                    end)
                end
            end
        end
    end
end)

