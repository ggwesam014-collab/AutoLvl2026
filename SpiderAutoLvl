-- Advanced Tool Equip by Attributes ("WeaponType") & Fallback ToolTip
local function equipWeapon()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- Check if currently equipped tool matches criteria
    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        local wType = currentTool:GetAttribute("WeaponType") or currentTool.ToolTip
        if _G.SelectedWeapon == "Melee" and (wType == "Melee" or currentTool:FindFirstChild("Melee")) then return end
        if _G.SelectedWeapon == "Sword" and (wType == "Sword" or currentTool:FindFirstChild("Sword")) then return end
        if _G.SelectedWeapon == "Blox Fruit" and (wType == "Blox Fruit" or wType == "Fruit" or currentTool:FindFirstChild("EatRemote")) then return end
    end

    -- Equip Tool From Backpack
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local wType = tool:GetAttribute("WeaponType") or tool.ToolTip
            
            if _G.SelectedWeapon == "Melee" then
                if wType == "Melee" or tool:FindFirstChild("Melee") or tool.Name == "Combat" or tool.Name:find("Step") or tool.Name:find("Kung") or tool.Name:find("Karate") or tool.Name:find("Claw") or tool.Name:find("Leg") or tool.Name:find("God") then
                    humanoid:EquipTool(tool)
                    break
                end
            elseif _G.SelectedWeapon == "Sword" then
                if wType == "Sword" or tool:FindFirstChild("Sword") then
                    humanoid:EquipTool(tool)
                    break
                end
            elseif _G.SelectedWeapon == "Blox Fruit" then
                if wType == "Blox Fruit" or wType == "Fruit" or tool:FindFirstChild("EatRemote") then
                    humanoid:EquipTool(tool)
                    break
                end
            end
        end
    end
end

-- Automatic Clicker / Attacker
local function doAttack()
    equipWeapon()
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(500, 500))
end

-- Smooth Tween Movement To Prevent Rubberband
local currentTween = nil
local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist < 5 then
        if currentTween then currentTween:Cancel() end
        hrp.CFrame = targetCFrame
        return
    end

    local speed = 280
    local tInfo = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
    
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(hrp, tInfo, {CFrame = targetCFrame})
    currentTween:Play()
end

-- Expand Mob Hitbox Function
local function expandHitbox(mob)
    if mob and mob:FindFirstChild("HumanoidRootPart") then
        local hrp = mob.HumanoidRootPart
        hrp.Size = Vector3.new(25, 25, 25)
        hrp.Transparency = 0.7
        hrp.CanCollide = false
    end
end

